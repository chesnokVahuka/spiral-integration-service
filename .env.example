# Environment (prod, local or testing)
APP_ENV=local

# Debug mode set to TRUE enables higher verbosity
DEBUG=true

# Verbosity level: basic, verbose, debug
VERBOSITY_LEVEL=verbose

# Monolog
MONOLOG_DEFAULT_CHANNEL=default
MONOLOG_DEFAULT_LEVEL=DEBUG
# Stream logs to Buggregator (leave empty to disable)
MONOLOG_SOCKET_HOST=buggregator:9913

# Tokenizer
TOKENIZER_CACHE_TARGETS=false
TOKENIZER_LOAD_CLASSES=true
TOKENIZER_LOAD_ENUMS=true
TOKENIZER_LOAD_INTERFACES=true

# Buggregator: dump() / dd() output
VAR_DUMPER_FORMAT=server
VAR_DUMPER_SERVER=buggregator:9912

# Buggregator: exceptions via Sentry protocol
SENTRY_DSN=http://sentry@buggregator:8000/1

# Docker compose: published ports
HTTP_PORT=8080
BUGGREGATOR_UI_PORT=8000
