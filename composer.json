{
    "name": "vahuka/spiral-integration-service",
    "type": "project",
    "description": "Monolithic PHP application on Spiral Framework and RoadRunner",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-sockets": "*",
        "spiral/framework": "^3.15.7",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/roadrunner-bridge": "^4.0",
        "spiral/roadrunner-cli": "^2.5",
        "spiral/sentry-bridge": "^2.3",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "spiral/code-style": "^2.2",
        "spiral/dumper": "^3.3.1",
        "spiral/testing": "^3.0",
        "vimeo/psalm": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "publish-cmd": "php app.php publish"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "spiral/composer-publish-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
